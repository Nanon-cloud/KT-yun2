# Default: a local AI served by Ollama (https://ollama.com). Nothing leaves your computer.
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2

# Optional cloud provider (needs: pip install -r requirements-gemini.txt)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash
